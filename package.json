{
  "name": "luminary",
  "version": "3.0.0",
  "description": "Professional-grade church presentation software — PWA + Tauri",
  "author": "Kennedy Muritu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-bible-sql.cjs && vite",
    "build": "node scripts/generate-icons.cjs && node scripts/generate-bible-sql.cjs && tsc -b && vite build",
    "bible:sql": "node scripts/generate-bible-sql.cjs",
    "turso:seed": "node scripts/generate-bible-sql.cjs && node scripts/seed-turso.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "biome check src e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "lint:fix": "biome check --write src e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "format": "biome format --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:web": "pnpm --filter @luminary/web dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "@tursodatabase/database-wasm": "^0.6.1",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@libsql/client": "^0.17.4",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-static-copy": "^2.3.0",
    "vitest": "^3.2.1"
  }
}
